# =============================================================================
# EcoViz_DiveDB environment configuration
# =============================================================================
# Copy to `.env` and fill in. The repo-root .env is the source of truth; the
# submodule .env files mirror it, each keeping only the variables that submodule
# reads. Keep shared values identical across them.
#
# Naming conventions (one spelling per concept -- do not reintroduce variants):
#   NOTION_TOKEN            the integration secret     (not NOTION_API_KEY)
#   NOTION_DB_<NAME>        a Notion database ID       (not NOTION_<NAME>_DB)
#   S3_*                    Ceph/S3 object storage     (AWS_* is a separate account)
#   LOCAL_*                 host paths
#   CONTAINER_*             paths as seen inside Docker
# =============================================================================

# -----------------------------------------------------------------------------
# NOTION METADATA
# -----------------------------------------------------------------------------
# Integration secret. One name only: NOTION_TOKEN.
NOTION_TOKEN=

# Database IDs, named NOTION_DB_<NAME>. The key reflects the database's title in
# Notion -- e.g. the organism database is titled "Organism DB", so the var is
# NOTION_DB_ORGANISM (the older ANIMAL spelling is retired).
NOTION_DB_DEPLOYMENT=
NOTION_DB_RECORDING=
NOTION_DB_LOGGER=
NOTION_DB_ORGANISM=
NOTION_DB_DATASET=
NOTION_DB_SIGNAL=
NOTION_DB_STANDARDIZED_CHANNEL=
NOTION_DB_SPECIES=
NOTION_DB_ASSET=
NOTION_DB_PROCEDURE=
NOTION_DB_OBSERVATION=
NOTION_DB_COLLABORATOR=
NOTION_DB_LOCATION=
NOTION_DB_MONTAGE=
NOTION_DB_ATTACHMENT=
NOTION_DB_ORIGINAL_CHANNEL=

# -----------------------------------------------------------------------------
# IMMICH MEDIA
# -----------------------------------------------------------------------------
IMMICH_API_KEY=
IMMICH_BASE_URL=

# -----------------------------------------------------------------------------
# PYOLOGGER
# -----------------------------------------------------------------------------
# Absolute path to pyologger/config.yaml
CONFIG_PATH=

PROCESSED_DATA_DIR=
PREPROCESSED_DATA_FILENAME=
SEGMENTATION_RUNS_PATH=
HOST_DELTA_LAKE_PATH=

# Orientation rendering limits (optional)
PYOLOGGER_ORIENTATION_MAX_RAW_ROWS=
PYOLOGGER_ORIENTATION_MAX_OUTPUT_ROWS=
PYOLOGGER_VIDEO_DIR=
PYOLOGGER_IMMICH_ENV=
